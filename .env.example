# Site
NEXT_PUBLIC_SITE_URL=https://suaci.com

# 백엔드가 어떤 어댑터로 도는지 — mock: 소셜·결제가 목업인 dev 스택(앱 안 목업 동의·즉시 성공 결제), http: 실제 카카오·네이버·토스(운영)
NEXT_PUBLIC_API_MODE=mock
# 백엔드 주소(필수 — 커머스 API는 늘 백엔드를 부른다. 로컬 개발은 dev 스택 주소). 이벤트 API(eventsApi)도 이 주소로 간다(없으면 mock)
NEXT_PUBLIC_API_BASE_URL=

# 소셜 로그인 클라 ID(각 프로바이더 콘솔). 비우면 개발·mock 모드는 앱 안 목업 동의 화면, 운영+http 는 그 버튼을 숨긴다
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
# 출시 전 숨길 소셜 로그인(쉼표 목록, 예: naver). 그 버튼은 주소에 ?with=naver 를 붙여 연 탭에서만 보인다(검수·앱 멤버 시험용)
NEXT_PUBLIC_SOCIAL_HIDDEN=
# 토스페이먼츠 'API 개별 연동 키'의 클라이언트 키(test_ck_ / live_ck_). 결제위젯 키(test_gck_)를 넣으면 결제창이 열리지 않는다.
# 있으면 결제창을 연다(없으면 운영은 결제 직전에서 멈춤). test_ 키면 화면에 '시험 결제' 안내가 붙는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 방문 분석·광고 측정(#84). 비워 두면 그 도구를 싣지 않는다. GA4는 G-로 시작, 메타 픽셀은 숫자
# 넣으면 첫 방문에 동의 배너가 뜨고 허용한 사람만 싣는다. 넣기 전에: 개인정보처리방침 새 판(6조 쿠키·국외 이전) 게시 +
# 배너 상세 문구(suaci-docs dev/2026-11-09-방문분석-광고측정-준비.md). 그 전에는 운영에 채우지 말 것.
# 메타 픽셀은 자동 고급 매칭을 끈 상태로 시작한다(/notify 이메일 폼 보호).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
