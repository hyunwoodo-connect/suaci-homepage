# Site
NEXT_PUBLIC_SITE_URL=https://suaci.com

# API (배포 후 http로 전환)
NEXT_PUBLIC_API_MODE=mock
# 커머스 http 모드의 주소이자, 값이 있으면 이벤트 API(eventsApi)도 이 주소로 간다(없으면 mock)
NEXT_PUBLIC_API_BASE_URL=

# 소셜 로그인 클라 ID(각 프로바이더 콘솔). 비우면 개발·mock 모드는 앱 안 목업 동의 화면, 운영+http 는 그 버튼을 숨긴다
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
# 출시 전 숨길 소셜 로그인(쉼표 목록, 예: naver). 그 버튼은 주소에 ?with=naver 를 붙여 연 탭에서만 보인다(검수·앱 멤버 시험용)
NEXT_PUBLIC_SOCIAL_HIDDEN=

# 방문 분석·광고 측정(#84). 비워 두면 그 도구를 싣지 않는다. GA4는 G-로 시작, 메타 픽셀은 숫자
# 주의: 개인정보처리방침에 행태정보(GA4·메타 픽셀) 고지를 반영하기 전에는 운영에 채우지 말 것.
# 메타 픽셀은 자동 고급 매칭을 끈 상태로 시작한다(/notify 이메일 폼 보호).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
